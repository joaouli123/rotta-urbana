# =============================================================================
# Rotta Urbana — Environment template. Copy to .env and fill in.
# (.env is gitignored; this .example file is safe to commit.)
# =============================================================================

# --- CLIENT (Expo app) — bundled into the app, PUBLIC values only -----------
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_AUTH_REDIRECT_URL=rotta-urbana://auth/reset-password
# Mapbox PUBLIC token (pk.) — create at https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.xxxxxxxxxxxxxxxxxxxx

# --- SERVER / CLI ONLY — never bundled --------------------------------------
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<database-password>
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
# Mapbox SECRET token (sk.) with DOWNLOADS:READ — build-time SDK download
MAPBOX_SECRET_DOWNLOAD_TOKEN=sk.xxxxxxxxxxxxxxxxxxxx

# --- Payments (Mercado Pago) ------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# OAuth/split secrets are server-only and must be configured in Coolify.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_SPLIT_REDIRECT_URI=https://rottaurbana.com.br/api/mercadopago/oauth/callback
MP_SPLIT_ENCRYPTION_KEY=
PAYMENTS_SIMULATE=true

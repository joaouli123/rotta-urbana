SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
SESSION_SECRET=<long-random-string>
PORT=3000

# Mercado Pago (secrets stay only in Coolify/server; never expose in Expo)
MERCADOPAGO_ACCESS_TOKEN=APP_USR_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Exact HTTPS callback configured in the Mercado Pago application.
MERCADOPAGO_SPLIT_REDIRECT_URI=https://rottaurbana.com.br/api/mercadopago/oauth/callback
# 32-byte AES key in hex. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MP_SPLIT_ENCRYPTION_KEY=
PUBLIC_APP_URL=https://rottaurbana.com.br

# Slug privado do painel administrativo (configure tamb?m no Coolify)
ADMIN_PANEL_SLUG=console-ru-7f3a9c
